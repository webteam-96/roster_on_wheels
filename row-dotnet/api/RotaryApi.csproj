<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>15a6eeda-1899-4604-9910-98a757f176f1</UserSecretsId>
  </PropertyGroup>

  <!--
    Prevent dotnet publish from recursively packing its own output folders
    back into the next publish (which causes MSB3030 "Could not copy..."
    nesting like publish-deploy/publish-output/publish/publish-deploy/...).
    Any folder matching these patterns is excluded from the project so
    `dotnet publish -c Release -o publish-deploy` is always safe.
  -->
  <ItemGroup>
    <Content Remove="publish-deploy/**" />
    <Content Remove="publish-output/**" />
    <Content Remove="publish/**" />
    <None Remove="publish-deploy/**" />
    <None Remove="publish-output/**" />
    <None Remove="publish/**" />
    <Compile Remove="publish-deploy/**" />
    <Compile Remove="publish-output/**" />
    <Compile Remove="publish/**" />
    <EmbeddedResource Remove="publish-deploy/**" />
    <EmbeddedResource Remove="publish-output/**" />
    <EmbeddedResource Remove="publish/**" />
  </ItemGroup>

  <!-- ROW logo for PDF reports, built into the API so a PDF never depends on a download. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/Brand/row-logo.png" LogicalName="Brand.row-logo.png" />
    <EmbeddedResource Include="Resources/Brand/row-logo-badge.png" LogicalName="Brand.row-logo-badge.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.1.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.73.0.4081" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.73.0.4061" />
    <PackageReference Include="MailKit" Version="4.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.7.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
