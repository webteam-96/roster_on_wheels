# Contact form email (app/contact-us/actions.ts). Copy this file to .env.local (or set the same names on the
# server) and fill both in. The form posts each request to a Google Apps Script web app (apps-script/Code.gs),
# which emails it to support@rosteronwheels.com from the Google account it is deployed under.

# The web app URL from Apps Script > Deploy > New deployment (ends in /exec)
MAIL_SCRIPT_URL=
# Any long random text; the same value goes in SECRET at the top of apps-script/Code.gs
MAIL_SECRET=

# Header "Login" button -> the ROW web application (admin portal, row/admin).
# Set the full login URL, e.g. https://portal.rosteronwheels.com/login
NEXT_PUBLIC_ADMIN_LOGIN_URL=
# Or just the portal origin; "/login" is appended. Falls back to http://localhost:3000/login in dev.
NEXT_PUBLIC_PORTAL_ORIGIN=
