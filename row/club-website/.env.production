# PRODUCTION build settings for ROW: `npm run build` loads this file. Every VITE_ value is compiled into the
# public browser bundle, so nothing secret may ever go here.
# The club sites call the ROW API from the browser; every api/public route allows any origin (PublicOpen CORS).
VITE_ApiBaseUrl=https://test.rosteronwheels.com/api
VITE_MediaBaseUrl=https://test.rosteronwheels.com
VITE_CacheTimeInMinutes=0
VITE_ApiTimeoutSeconds=20
VITE_AdminLoginUrl=https://test.rosteronwheels.com/admin/login
# Used when the API gives no per-club renewal pay link (Expired page).
VITE_RenewUrl=https://test.rosteronwheels.com/admin/club-admin-dashboard/website-purchase
# Support contact on the Expired / Not-configured pages. Blank = not shown.
VITE_SupportEmail=support@rosteronwheels.com
VITE_SupportPhone=+91 84240 64369, +91 89287 55144
# Local-only overrides: keep BLANK in production.
VITE_DevHostOverride=
VITE_DevThemeOverride=
VITE_DevThemePortMap=
VITE_PreviewEventImages=
VITE_DefaultWebsiteId=
VITE_ForcedTheme=
VITE_ClubThemeMap=
VITE_ThemePreviewKey=
# Footer visitor counter: the ROW API's own endpoint (same contract as the old visits.php).
VITE_VisitorCountUrl=https://test.rosteronwheels.com/api/public/club-website/visits
VITE_VisitorCountSeed=
