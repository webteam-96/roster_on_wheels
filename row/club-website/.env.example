# Mirror of Faster_ClubWebsite/Web.config <appSettings>. Copy to .env.local.
# Same keys, same meanings, same defaults — see src/config.js.

VITE_ApiBaseUrl=http://localhost:5000/api
VITE_MediaBaseUrl=http://localhost:5000

# 0 = INSTANT (content re-fetched on every navigation; admin edits reflect at once)
VITE_CacheTimeInMinutes=0
VITE_ApiTimeoutSeconds=20

# ── LOCAL ONLY — every one of these MUST be blank in a production build ──────
# Resolve this club instead of the browser's hostname (localhost maps to nothing).
VITE_DevHostOverride=
# Force a theme key: classic-blue | warm-modern | madras-legacy | civic-bold | verdigris-ledger
VITE_DevThemeOverride=
# Per-port theme pins for a multi-port preview, e.g. 8091=warm-modern;8092=civic-bold
VITE_DevThemePortMap=
# Fallback club id when the host doesn't resolve
VITE_DefaultWebsiteId=

# ── PRODUCTION ──────────────────────────────────────────────────────────────
# Per-club pin (beats ForcedTheme), e.g. 2037=madras-legacy;rcguindy=warm-modern
VITE_ClubThemeMap=
# Global lock — pins EVERY club to one theme. Blank = clubs get their dashboard pick.
VITE_ForcedTheme=
# Shared key that unlocks ?theme=X&pk=KEY live previews. Blank = feature inert.
VITE_ThemePreviewKey=

VITE_AdminLoginUrl=http://localhost:3000/login
VITE_RenewUrl=
VITE_SupportEmail=
VITE_SupportPhone=

# Footer visitor counter. Blank = localStorage (one browser, NOT per-IP). Set to
# an endpoint returning {"total":n,"today":n} for ?club=<clubId> for a real
# IP-deduped site total. See src/shared/visitorCount.jsx.
VITE_VisitorCountUrl=
# Baseline added to the all-time figure (carry-over from the previous site).
# Local mode only, never applied to "Today", and it makes the caption read
# "Visitors" instead of "Your visits". 0 = start from zero.
VITE_VisitorCountSeed=0
