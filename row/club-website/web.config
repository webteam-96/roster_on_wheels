<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- ROW club website (Next.js) on IIS through HttpPlatformHandler (not iisnode).
       One app serves every club subdomain: point every club host (and any configured custom
       domain) at this folder. server.js reads the Host header; the Next.js middleware passes it
       on as x-tenant-host for tenant resolution.
       IIS starts "node server.js" and hands it a port in HTTP_PLATFORM_PORT; server.js reads PORT.
       Requires: HttpPlatformHandler v1.2, Node 22 at the path below, app pool "No Managed Code". -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
      </handlers>
      <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                    arguments="server.js"
                    startupTimeLimit="120"
                    stdoutLogEnabled="true"
                    stdoutLogFile=".\logs\node">
        <environmentVariables>
          <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
          <environmentVariable name="NODE_ENV" value="production" />
          <environmentVariable name="HOSTNAME" value="127.0.0.1" />
          <!-- Server-side page data straight from the API site (see row/deploy/iis/README.md). -->
          <environmentVariable name="INTERNAL_API_URL" value="https://api.test.rosteronwheels.com" />
        </environmentVariables>
      </httpPlatform>
    </system.webServer>
  </location>
</configuration>
