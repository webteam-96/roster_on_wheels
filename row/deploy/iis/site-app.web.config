<?xml version="1.0" encoding="UTF-8"?>
<!-- ROW public website (row/website) for the test host. Lives in the "site" folder of the site root and is marked as an
     APPLICATION in Plesk (Virtual Directories > site > Mark as application), like "api". Built with SITE_BASE_PATH=/site
     and NEXT_PUBLIC_PORTAL_ORIGIN=https://test.rosteronwheels.com, so every page and asset lives under /site and the
     Login button opens the admin's /login on the same host. The root web.config sends "/" here.
     The demo form needs MAIL_SCRIPT_URL and MAIL_SECRET: set them on the server only (never in git). -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="server.js"
                  startupTimeLimit="120"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
