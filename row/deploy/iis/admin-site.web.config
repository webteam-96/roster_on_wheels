<?xml version="1.0" encoding="UTF-8"?>
<!-- ROW test go-live (2026-10-30), Plesk site root D:\Inetpub\vhosts\rosteronwheels.com\test.rosteronwheels.com
     This web.config sits in the SITE ROOT with the admin frontend (Next.js standalone: server.js, .next, node_modules, public).
     - /api/*  -> the "api" folder, marked as an APPLICATION in Plesk (Virtual Directories > api > Mark as application);
                  IIS sends those requests straight to it, so no rule is needed here.
     - /uploads/*, /Documents/*, /tempdocument/*  -> rewritten inside the site to /api/... (the API serves its media)
     - everything else -> the admin's Node server (HttpPlatformHandler + Node 22 at the path below)
     inheritInChildApplications="false" keeps these rules and the Node handler out of the api application.
     Secrets are NOT set here (see row/deploy/iis/README.md). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="ROW media to the api application" stopProcessing="true">
            <match url="^(uploads|Documents|tempdocument)(/.*)?$" />
            <action type="Rewrite" url="api/{R:0}" appendQueryString="true" />
          </rule>
        </rules>
      </rewrite>
      <handlers>
        <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
      </handlers>
      <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                    arguments="server.js"
                    startupTimeLimit="120"
                    stdoutLogEnabled="true"
                    stdoutLogFile=".\logs\node">
        <environmentVariables>
          <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
          <environmentVariable name="HOSTNAME" value="127.0.0.1" />
          <environmentVariable name="NODE_ENV" value="production" />
          <!-- Server-side calls from the admin reach the API on the same host. -->
          <environmentVariable name="API_INTERNAL_URL" value="https://test.rosteronwheels.com" />
        </environmentVariables>
      </httpPlatform>
      <!-- Uploads pass through the site: same 55 MB ceiling as the API (Program.cs MaxRequestBodyBytes). -->
      <security>
        <requestFiltering allowDoubleEscaping="true">
          <requestLimits maxAllowedContentLength="57671680" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
