<?xml version="1.0" encoding="UTF-8"?>
<!-- ROW admin panel for the test host (layout of 2026-11-02). Lives in the "admin" folder of the site root and is marked
     as an APPLICATION in Plesk (Virtual Directories > admin > Mark as application), like "api". App pool: No Managed Code.
     Built with NEXT_PUBLIC_BASE_PATH=/admin and NEXT_PUBLIC_API_URL=https://test.rosteronwheels.com, so every page and
     asset lives under /admin and API calls go to /api on the same host. IIS passes the full path (/admin/...) to Node.
     Secrets are NOT set here (see row/deploy/iis/README.md). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{HTTPS}" pattern="off" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="server.js"
                  startupTimeLimit="120"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Server-side calls from the admin reach the API on the same host. -->
        <environmentVariable name="API_INTERNAL_URL" value="https://test.rosteronwheels.com" />
      </environmentVariables>
    </httpPlatform>
    <!-- Uploads go from the admin straight to /api; this ceiling matches the API's 55 MB (Program.cs MaxRequestBodyBytes). -->
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="57671680" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
