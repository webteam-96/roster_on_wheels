<?xml version="1.0" encoding="UTF-8"?>
<!-- ROW test host (Plesk site root D:\Inetpub\vhosts\rosteronwheels.com\test.rosteronwheels.com), layout of 2026-11-02:
     This web.config sits in the SITE ROOT with the ROW public website (row/website, Next.js standalone: server.js,
     .next, node_modules, public), built WITHOUT a base path and with
     NEXT_PUBLIC_PORTAL_ORIGIN=https://test.rosteronwheels.com/admin so its Login button opens /admin/login.
     - /admin/*  -> the "admin" folder, marked as an APPLICATION in Plesk (Virtual Directories > admin > Mark as
                    application): the admin panel, built with NEXT_PUBLIC_BASE_PATH=/admin (its own web.config).
     - /api/*    -> the "api" folder, also an APPLICATION: the .NET API.
     - /uploads/*, /Documents/*, /tempdocument/*  -> rewritten to /api/... (the API serves its media)
     - /login    -> redirected to /admin/login (old links and bookmarks from the earlier layout)
     - everything else -> the website's Node server (HttpPlatformHandler + Node 22 at the path below)
     inheritInChildApplications="false" keeps these rules and the Node handler out of the admin and api applications.
     The website's demo form needs MAIL_SCRIPT_URL and MAIL_SECRET: set them on the server only (never in git).
     Secrets are NOT set here (see row/deploy/iis/README.md). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="ROW media to the api application" stopProcessing="true">
            <match url="^(uploads|Documents|tempdocument)(/.*)?$" />
            <action type="Rewrite" url="api/{R:0}" appendQueryString="true" />
          </rule>
          <rule name="Old admin login to /admin" stopProcessing="true">
            <match url="^login/?$" />
            <action type="Redirect" url="admin/login" redirectType="Permanent" appendQueryString="true" />
          </rule>
        </rules>
      </rewrite>
      <handlers>
        <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
      </handlers>
      <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                    arguments="server.js"
                    startupTimeLimit="120"
                    stdoutLogEnabled="true"
                    stdoutLogFile=".\logs\node">
        <environmentVariables>
          <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
          <environmentVariable name="HOSTNAME" value="127.0.0.1" />
          <environmentVariable name="NODE_ENV" value="production" />
        </environmentVariables>
      </httpPlatform>
      <!-- Media uploads pass through the root rewrite: same 55 MB ceiling as the API (Program.cs MaxRequestBodyBytes). -->
      <security>
        <requestFiltering allowDoubleEscaping="true">
          <requestLimits maxAllowedContentLength="57671680" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
