<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for the static ROW AI Assistant (assistant.<your-domain>).
  Copied verbatim into out/ by `next build`; scripts/csp-hashes.mjs then replaces the
  placeholder in script-src below with the sha256 hashes of the inline bootstrap scripts
  Next.js writes into each exported page — so script-src needs no 'unsafe-inline'.
  Always deploy the out/ produced by `npm run build` (never a bare `next build`).
  Requires the IIS URL Rewrite module (already used by the admin portal site).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Pages are exported as folders (trailingSlash: true): / → index.html, /login/ → login/index.html.
         /login (no slash) is redirected to /login/ so the default document resolves it. -->
    <rewrite>
      <rules>
        <rule name="Add trailing slash to page folders" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="/{R:1}/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Anything else that doesn't exist gets the exported 404 page (with a real 404 status). -->
    <httpErrors>
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <!-- Remove-then-add avoids a 500 "duplicate entry" if the server already maps it. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- HTML must revalidate on every load: it pins this build's chunk names and CSP hashes. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://rosteronwheels.com https://*.rosteronwheels.com; font-src 'self'; connect-src 'self' https://rosteronwheels.com https://*.rosteronwheels.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Hashed build assets never change — cache them for a year. -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
