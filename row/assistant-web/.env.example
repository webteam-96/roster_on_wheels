# Base URL of the Rotary API (no trailing slash). Inlined into the static bundle at BUILD time,
# so set it before `npm run build`. Copy to .env.local for local development.
NEXT_PUBLIC_API_URL=https://<your-api-host>/api

# Optional: where project photos load from. Defaults to NEXT_PUBLIC_API_URL. For local development
# against a local API, point it at the live server: https://<your-api-host>/api
# NEXT_PUBLIC_PHOTO_BASE_URL=https://<your-api-host>/api
