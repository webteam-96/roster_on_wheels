<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>ROW - Nightly Club Reconcile. Full /clubs pass (NOT the /clubs/updates change feed): flips clubs from non-sync to sync, inserts clubs missing from ROW, then syncs members for ONLY those changed clubs. Ends by comparing the ROW synced-club count against the Rotary.org /clubs total. Never deletes - the sync-to-non-sync direction stays behind --non-sync-cascade --apply. REPLACES the old Clubs Repair Sync task (--repair-sync), which flipped flags but never pulled members.</Description>
    <Author>Kaizen Projects</Author>
    <URI>\ROW\Club Reconcile</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-07-16T02:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT4H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>D:\inetpub\vhosts\portal.example.org\httpdocs\RotaryOrgSyncWorker\RotaryOrgSyncWorker.exe</Command>
      <Arguments>--club-reconcile</Arguments>
      <WorkingDirectory>D:\inetpub\vhosts\portal.example.org\httpdocs\RotaryOrgSyncWorker</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
