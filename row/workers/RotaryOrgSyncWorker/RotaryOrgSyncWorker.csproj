<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RotaryOrgSyncWorker</RootNamespace>
    <AssemblyName>RotaryOrgSyncWorker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!-- MailKit pulls in 10.0.0, which has known advisories. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- ROW instance brand, shared with the API (Brand section / Brand__* environment variables). -->
    <Compile Include="../../api/Services/Brand.cs" Link="Brand.cs" />
    <Compile Include="../../api/Services/CountryCurrency.cs" Link="CountryCurrency.cs" />
    <!-- Masks email addresses in log lines (same code as the API). -->
    <Compile Include="../../api/Services/LogMask.cs" Link="LogMask.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- One MySQL connection factory for API and workers: every session runs in UTC. -->
    <Compile Include="..\..\api\Services\RowDb.cs" Link="Shared\RowDb.cs" />
    <!-- Club Admin limit per club (same rule as the API). -->
    <Compile Include="..\..\api\Services\ClubAdminLimit.cs" Link="Shared\ClubAdminLimit.cs" />
  </ItemGroup>
</Project>
