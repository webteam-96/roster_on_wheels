<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- ROW admin portal (Next.js) on IIS through HttpPlatformHandler (not iisnode).
       IIS starts "node server.js" and hands it a port in HTTP_PLATFORM_PORT; server.js reads PORT.
       Requires: HttpPlatformHandler v1.2, Node 22 at the path below, app pool "No Managed Code".
       Build first (npm ci && npm run build); set NEXT_PUBLIC_* values before building. -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
      </handlers>
      <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                    arguments="server.js"
                    startupTimeLimit="120"
                    stdoutLogEnabled="true"
                    stdoutLogFile=".\logs\node">
        <environmentVariables>
          <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
          <environmentVariable name="NODE_ENV" value="production" />
        </environmentVariables>
      </httpPlatform>
    </system.webServer>
  </location>
</configuration>
