<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\RotaryApi.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- IIS request-filtering — frontend's 50 MB hard cap leaves multipart
           overhead room before hitting this 55 MB ceiling. Without this, IIS
           returns a generic 404.13 BEFORE the ASP.NET pipeline (and our
           Program.cs Kestrel limit) ever sees the request, so the user gets
           an opaque error instead of our intended 413. Bytes here MUST match
           the MaxRequestBodyBytes constant in Program.cs. -->
      <!-- allowDoubleEscaping="true": legacy e-bulletin/media filenames contain a
           literal '+' (e.g. RC+Pulse+01_...pdf). By default IIS request filtering
           REJECTS a '+' in the URL path with a 404 BEFORE the request reaches the
           app, so the PDF 404s in the browser even though the file exists. This
           lets those '+' paths through to be served normally. -->
      <security>
        <requestFiltering allowDoubleEscaping="true">
          <requestLimits maxAllowedContentLength="57671680" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
