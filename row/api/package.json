{
  "name": "row-api",
  "version": "0.1.0",
  "private": true,
  "description": "ROW backend: NestJS port of the RIZones .NET API (same routes, same JSON, same MySQL schema)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "jest",
    "db:schema": "node scripts/apply-sql.mjs database/schema.sql database/schema-drift.sql",
    "db:seed": "node scripts/apply-sql.mjs database/seed-master.sql",
    "bootstrap:superadmin": "node dist/cli/bootstrap-superadmin.js",
    "lint:rizones": "node tools/check-rizones.mjs src"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "bcryptjs": "3.0.3",
    "docx": "9.0.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "jszip": "3.10.2",
    "mysql2": "3.24.4",
    "pdfmake": "0.2.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pdfmake": "0.2.9",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
